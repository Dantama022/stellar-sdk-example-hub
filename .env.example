# Stellar SDK Example Hub Configuration

# Selected Stellar network: testnet | mainnet
# Used by 60-network-configuration (and can guide other examples).
STELLAR_NETWORK=testnet

# Optional Horizon endpoint URL overrides
HORIZON_URL=https://horizon-testnet.stellar.org

# Optional Soroban RPC endpoint URL overrides
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional network passphrase override (must match STELLAR_NETWORK / Horizon)
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
# NETWORK_PASSPHRASE=Test SDF Network ; September 2015
