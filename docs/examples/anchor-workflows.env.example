# Optional environment template for issue #450–#453 examples.
# Mock mode (default) performs no network calls; these settings are unnecessary.
# Do not commit a real .env with JWTs, customer identifiers or credentials.
ANCHOR_MODE=mock
ANCHOR_ALLOW_REQUESTS=false

# Read the relevant protocol README before deliberately enabling live requests.
# SEP24_TRANSFER_SERVER=https://test-anchor.example.invalid/sep24
# SEP24_JWT=
# SEP24_ACCOUNT=
# SEP24_ASSET=USD
# SEP24_ACTION=deposit

# SEP12_KYC_SERVER=https://test-anchor.example.invalid/kyc
