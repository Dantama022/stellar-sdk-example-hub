{
  "name": "soroban-argument-encoding",
  "version": "1.0.0",
  "description": "Validate and encode Soroban contract function arguments into ScVal/XDR (read-only, no transactions)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": ["stellar", "soroban", "scval", "xdr", "argument-encoding"],
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^13.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"]
  }
}
