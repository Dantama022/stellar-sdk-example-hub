{
  "name": "soroban-wasm-provenance-verification",
  "version": "1.0.0",
  "description": "Verify the integrity and provenance of a Soroban contract WASM artifact (checksum, toolchain record, deployed executable comparison)",
  "main": "dist/src/verify.js",
  "scripts": {
    "build": "tsc",
    "verify": "ts-node src/verify.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "stellar",
    "soroban",
    "scval",
    "xdr",
    "wasm",
    "provenance",
    "reproducible-build"
  ],
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^13.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
